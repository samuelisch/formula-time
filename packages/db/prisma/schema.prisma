// The stored model: five tables, one writer each (ADR-0001 seam 3, HLD §4).
// ingest writes `sessions` and `events`; api writes `polls`, `votes`, and
// (ADR-0009) `exports`. This package exposes the client; it does not
// encode that ownership.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// PSL wants one enum value per line; names and values are the brief's, verbatim.
enum SessionStatus {
  upcoming
  live
  finished
}

enum PollStatus {
  open
  locked
  resolved
  void
}

model Session {
  sessionKey  BigInt        @id @map("session_key")
  name        String
  country     String
  circuitKey  Int           @map("circuit_key")
  dateStart   DateTime      @map("date_start")
  dateEnd     DateTime      @map("date_end")
  totalLaps   Int?          @map("total_laps")
  status      SessionStatus
  events      Event[]
  polls       Poll[]
  export      Export?
  @@map("sessions")
}

model Event {
  eventId     String    @id @map("event_id")
  sessionKey  BigInt    @map("session_key")
  endpoint    String
  sourceTime  DateTime? @map("source_time")
  receivedAt  DateTime  @default(now()) @map("received_at")
  payload     Json
  seq         BigInt    @default(autoincrement()) @unique
  session     Session   @relation(fields: [sessionKey], references: [sessionKey])
  @@index([sessionKey, sourceTime])
  @@map("events")
}

model Poll {
  pollId           String     @id @map("poll_id")
  sessionKey       BigInt     @map("session_key")
  question         String
  options          Json
  locksAtLap       Int        @map("locks_at_lap")
  status           PollStatus
  winningOptionIds Json?      @map("winning_option_ids")
  resolvedAt       DateTime?  @map("resolved_at")
  session          Session    @relation(fields: [sessionKey], references: [sessionKey])
  votes            Vote[]
  @@map("polls")
}

model Vote {
  pollId    String   @map("poll_id")
  viewerId  String   @map("viewer_id") @db.Uuid
  optionId  String   @map("option_id")
  votedAt   DateTime @default(now()) @map("voted_at")
  poll      Poll     @relation(fields: [pollId], references: [pollId])
  @@id([pollId, viewerId])
  @@map("votes")
}

// ADR-0009 §2: "the export record lives in a fifth table, `exports`
// (session_key bigint primary key references sessions, exported_at
// timestamptz not null, path text not null), written only by the api. The
// `sessions.exported_at` column from HLD §4 is dropped in the same
// migration; two writers on one row (ingest's upsert and the exporter) was
// the footgun this avoids."
model Export {
  sessionKey BigInt   @id @map("session_key")
  exportedAt DateTime @map("exported_at")
  path       String
  session    Session  @relation(fields: [sessionKey], references: [sessionKey])
  @@map("exports")
}
