# docs/ holds untracked drafts; only decisions and retros are committed
/docs/*
!/docs/decisions-adr/
!/docs/retros/

# toolchain
node_modules/
dist/
*.tsbuildinfo
.env
.env.*
coverage/

# ingest's jsonl recording (LIVE_LOG_DIR default ./live-logs) — the
# irreplaceable artefact, but not repo content (issue #22 deliverable 3/5).
# Not root-anchored: LIVE_LOG_DIR is relative to cwd, and `pnpm dev:ingest`
# runs with cwd apps/ingest, so the directory can appear there too.
live-logs/

# agent worktrees and SDD scratch
/.claude/worktrees/
/.superpowers/

# POC recordings copied for local replay (LIVE_SOURCE) and demos; not repo content
/recordings/

# api export files (EXPORT_DIR default ./exports, ADR-0009); regenerated from Postgres, not repo content
/exports/

# e2e-stack.sh's pid file and logs for the rehearse-race stack it drives
/.e2e/

# Playwright's own run output (traces, the HTML report)
apps/web/test-results/
apps/web/playwright-report/
